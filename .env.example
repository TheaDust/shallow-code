# ShallowCode 网关配置模板
# 复制为仓库根目录的 .env 后填写；.env 已被 .gitignore 排除，不会入库。
# 真实环境变量优先于 .env 文件中的值。

# OpenAI-compatible 网关的 API key
OPENAI_API_KEY=

# 网关基础地址，例如 https://gateway.example.com/v1
OPENAI_BASE_URL=

# 模型名称，例如 provider/model
MODEL=

# 可选：Grouper（功能分组）、Builder 与 Verifier 分别覆盖网关配置；
# 每个角色都能独立设置 API key、地址和模型，未设置的字段回退上方公共值。
# requirements-agent 读取同一份根目录 .env，用 REQUIREMENTS_AGENT_API_KEY /
# REQUIREMENTS_AGENT_BASE_URL / REQUIREMENTS_AGENT_MODEL 单独覆盖。
# SHALLOW_GROUPER_API_KEY=
# SHALLOW_GROUPER_BASE_URL=
# SHALLOW_GROUPER_MODEL=
# SHALLOW_BUILDER_API_KEY=
# SHALLOW_BUILDER_BASE_URL=
# SHALLOW_BUILDER_MODEL=
# SHALLOW_VERIFIER_API_KEY=
# SHALLOW_VERIFIER_BASE_URL=
# SHALLOW_VERIFIER_MODEL=

# Verifier 是唯一验收引擎；缺省 active。
# SHALLOW_VERIFIER_MODE=active
# Verifier 并发槽：1 或 2；缺省 2。恢复沿用原运行配置。
# SHALLOW_VERIFIER_CONCURRENCY=2
# 独立语义复核、历史程序重放：分别控制，缺省均关闭；设为 1 开启。
# 恢复运行沿用 run.json 保存的设置。
SHALLOW_VERIFIER_SEMANTIC_REVIEW=0
SHALLOW_VERIFIER_REPLAY=0

# 可选：主线 Builder 的上下文窗口，缺省 256000；允许 131072..1000000。
# 较小窗口会更早压缩长工具历史，降低重复输入 token。
# SHALLOW_BUILDER_CONTEXT_WINDOW=256000

# 可选：模型单价（USD / 百万 token），用于实时统计花费。
# 缺省按网关地址与模型 id 匹配 pi-ai 内置模型目录的标价（覆盖 opencode 等网关）；
# 目录未收录或需要覆盖时按字段设置，未设置的字段回退目录值。
# 目录未收录的模型需填齐四项后才估算费用；免费项显式填 0。
# <组件>_COST_* 只作用于该组件：SHALLOW_GROUPER_COST_*、SHALLOW_BUILDER_COST_*、SHALLOW_VERIFIER_COST_*、
# REQUIREMENTS_AGENT_COST_*；MODEL_COST_* 作为公共兜底。目录与配置均无价格时仅统计 token。
# build 按总计、Grouper、Builder、Verifier 分别显示用量；未定价部分会显式标注，不按免费计算。
# MODEL_COST_INPUT=
# MODEL_COST_OUTPUT=
# MODEL_COST_CACHE_READ=
# MODEL_COST_CACHE_WRITE=

# 可选：Evolution 是否验收历史 plan 中的沿用需求，缺省 0。
# 设为 0 时仅验收新增、历史记录缺失及明确修改项；设为 1 同时回归沿用项。
# SHALLOW_EVOLUTION_AUDIT_INHERITED=0

# 可选：运行日志（run-log.txt 与 run-ledger.jsonl）的存放目录。
# 缺省放在系统临时目录 %TMP%/shallowcode-runs/<运行ID>/；设置后仍按运行 ID 分子目录。
# SHALLOW_RUN_DIR=

# 可选：诊断用 SSE 抓包。设为 1/true 时把 Pi Worker 收到的每个 text/event-stream
# 响应体原样落到 <SHALLOW_RUN_DIR>/<运行ID>/sse-capture/，也可直接写目录路径。
# 仅在排查网关坏块时打开；抓到的内容含被测应用代码与模型输出，不要入库。
# SHALLOW_CAPTURE_SSE=
