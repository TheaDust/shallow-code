{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Checker 内部流程",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [960, 970],
    "legend": { "mode": "hidden" }
  },
  "lanes": [
    { "id": "job", "label": "任务" },
    { "id": "explore", "label": "探索" },
    { "id": "program", "label": "程序" },
    { "id": "replay", "label": "重放" },
    { "id": "review", "label": "复核" },
    { "id": "evidence", "label": "证据" },
    { "id": "result", "label": "结论" }
  ],
  "phases": [
    { "id": "prepare", "label": "准备", "fromCol": 0, "toCol": 0 },
    { "id": "execute", "label": "探索与执行", "fromCol": 1, "toCol": 3, "variant": "emphasis" },
    { "id": "decide", "label": "复核与判定", "fromCol": 4, "toCol": 5, "variant": "security" }
  ],
  "mainPath": ["check_job", "explore", "program", "replay", "receipts", "semantic", "evaluate", "report"],
  "nodes": [
    { "id": "check_job", "lane": "job", "col": 0, "type": "backend", "label": "CheckJob", "sublabel": "快照 · 需求 · 初态" },
    { "id": "explore", "lane": "explore", "col": 1, "type": "backend", "label": "探索模型", "sublabel": "invoke · save · finish" },
    { "id": "program", "lane": "program", "col": 2, "type": "messagebus", "label": "检查程序", "sublabel": "JavaScript + 合同" },
    { "id": "replay", "lane": "replay", "col": 3, "type": "security", "label": "全新环境重放", "sublabel": "应用 · 数据 · 浏览器" },
    { "id": "receipts", "lane": "evidence", "col": 3, "type": "database", "label": "逐子句收据", "sublabel": "GIVEN · WHEN · THEN" },
    { "id": "semantic", "lane": "review", "col": 4, "type": "backend", "label": "语义复核", "sublabel": "独立模型 · 只读证据" },
    { "id": "evaluate", "lane": "evidence", "col": 5, "type": "database", "label": "逐子句判定", "sublabel": "合同 × 收据" },
    { "id": "confirm", "lane": "replay", "col": 5, "type": "security", "label": "失败复现", "sublabel": "另一个新环境", "tag": "必须复现" },
    { "id": "report", "lane": "result", "col": 5, "type": "database", "label": "检查报告", "sublabel": "四态 · 可追溯" }
  ],
  "edges": [
    { "id": "job-explore", "from": "check_job", "to": "explore", "variant": "emphasis" },
    { "id": "explore-program", "from": "explore", "to": "program", "variant": "emphasis" },
    { "id": "run", "from": "program", "to": "replay" },
    { "id": "collect", "from": "replay", "to": "receipts", "route": "drop", "fromSide": "bottom", "toSide": "top" },
    { "id": "review", "from": "receipts", "to": "semantic" },
    { "id": "approve", "from": "semantic", "to": "evaluate" },
    { "id": "fail", "from": "evaluate", "to": "confirm", "variant": "security", "role": "branch", "route": "drop", "fromSide": "top", "toSide": "bottom" },
    { "id": "reproduce", "from": "confirm", "to": "evaluate", "variant": "dashed", "role": "return", "route": "drop", "fromSide": "bottom", "toSide": "top" },
    { "id": "finalize", "from": "evaluate", "to": "report", "variant": "emphasis", "route": "drop", "fromSide": "bottom", "toSide": "top" },
    { "id": "reject", "from": "semantic", "to": "report", "variant": "security", "role": "error" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "为什么可信",
      "items": [
        "程序由宿主重放，模型自述不算结果",
        "每个结果子句独立映射证据收据",
        "业务失败必须在另一个新环境复现"
      ]
    },
    {
      "dot": "emerald",
      "title": "成本控制",
      "items": [
        "已批准程序按 binding 与初态复用",
        "语义复核结果按内容缓存",
        "探索与复核共享任务预算和截止时间"
      ]
    }
  ]
}
