    { "id": "explore", "lane": "explore", "col": 0, "type": "backend", "label": "探索模型", "height": 40 },
    { "id": "program", "lane": "run", "col": 0, "type": "messagebus", "label": "保存程序", "height": 40 },
    { "id": "replay", "lane": "run", "col": 1, "type": "security", "label": "独立执行", "height": 40 },
    { "id": "semantic", "lane": "review", "col": 4, "type": "backend", "label": "语义复核", "height": 40 },
    { "id": "receipts", "lane": "evidence", "col": 1, "type": "database", "label": "逐子句收据", "height": 40 },
    { "id": "evaluate", "lane": "evidence", "col": 4, "type": "database", "label": "逐子句判定", "height": 40 },
    { "id": "confirm", "lane": "result", "col": 5, "type": "security", "label": "失败复现", "height": 40 },
