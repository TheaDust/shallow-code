    { "id": "review-decision", "from": "semantic", "to": "evaluate", "variant": "dashed" },
    { "id": "fail", "from": "evaluate", "to": "confirm", "variant": "security", "role": "branch" },
    { "id": "record", "from": "confirm", "to": "report", "variant": "dashed", "role": "return" },
    { "id": "finalize", "from": "evaluate", "to": "report", "variant": "emphasis" }
