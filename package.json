{
  "name": "shallowcode",
  "version": "0.1.0",
  "private": true,
  "bin": { "shallow": "bin/shallow.mjs" },
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "tsx --test --test-concurrency=1 test/browser/*.test.ts",
    "test:all": "npm run typecheck && npm test && npm run test:browser",
    "setup": "node scripts/setup.mjs",
    "smoke:credentials": "tsx --test --test-name-pattern=\"credential smoke\" test/credential-smoke.test.ts",
    "start": "tsx index.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@playwright/test": "1.57.0",
    "koffi": "2.16.3",
    "quickjs-emscripten": "0.32.0",
    "typebox": "1.3.30",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "koffi@2.16.3": true
  }
}
